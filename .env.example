# Copiar a .env y cambiar los valores. Nunca commitear .env.
POSTGRES_USER=bodegas
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=bodegas_del_atuel
POSTGRES_PORT=5432

# Roles de la aplicación. No commitear .env.
# DB_PASSWORD es la contraseña de app_rw; REPORTE_RO_PASSWORD es la de reporte_ro.
DB_PASSWORD=cambiar_esta_clave_api
REPORTE_RO_PASSWORD=cambiar_esta_clave_reportes
